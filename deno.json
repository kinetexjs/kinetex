{
  "name": "@kinetexjs/kinetex",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "nodeModulesDir": "none",
  "description": "Feature-rich, universal TypeScript HTTP client.",
  "exports": {
    ".": "./src/mod.ts",
    "./cache": "./src/cache.ts",
    "./sse": "./src/sse.ts",
    "./graphql": "./src/graphql.ts",
    "./pagination": "./src/pagination.ts",
    "./progress": "./src/progress.ts",
    "./logging": "./src/logging.ts",
    "./response": "./src/response.ts",
    "./headers": "./src/headers.ts",
    "./url": "./src/url.ts",
    "./aws-sigv4": "./src/aws-sigv4.ts",
    "./socks5": "./src/socks5.ts",
    "./cookiejar": "./src/cookiejar.ts",
    "./cookie-parser": "./src/cookie-parser.ts",
    "./worker": "./src/worker.ts",
    "./circuit-breaker": "./src/circuit-breaker.ts",
    "./dedup": "./src/dedup.ts",
    "./digest": "./src/digest.ts",
    "./ws": "./src/ws.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./interceptors": "./src/interceptors.ts",
    "./core": "./src/core.ts",
    "./types": "./src/types.ts"
  },
  "publish": {
    "include": ["src/**/*.ts", "deno.json", "README.md", "LICENSE"],
    "exclude": ["tests/**", "dist/**", "scripts/**"]
  },
  "lint": {
    "include": ["src/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "tasks": {
    "check": "deno check src/",
    "lint": "deno lint",
    "fmt": "deno fmt src/",
    "test": "deno run --allow-net --allow-env --allow-read --allow-sys tests/runtime/deno/Deno.test.mts && deno run --allow-net --allow-env --allow-read --allow-sys tests/runtime/deno/cross-runtime-deno.test.mts",
    "deno:battle": "deno run --allow-net --allow-env --allow-read --allow-sys tests/runtime/deno/Deno.test.mts",
    "build": "deno run --allow-read --allow-write --allow-run scripts/build.ts"
  }
}
